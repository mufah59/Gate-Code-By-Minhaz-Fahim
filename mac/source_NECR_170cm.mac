##########################################################
# F-18 Source Definition for 175cm Phantom
# Location: Inside line_source volume (hollow water tube)
# Activity: 33,860 Bq (2 kBq/cc × 16.93 cm³)
# Distribution: Uniform within active volume
#########################################################
/gate/source/addSource F18_175cm
/gate/source/F18_175cm/setActivity 33860 becquerel

# Particle type: Positron (e+)
/gate/source/F18_175cm/gps/particle e+

# F-18 decay properties
/gate/source/F18_175cm/setForcedUnstableFlag true
/gate/source/F18_175cm/setForcedHalfLife 6586.2 s
/gate/source/F18_175cm/gps/energytype Fluor18

/gate/source/F18_175cm/gps/type Volume
/gate/source/F18_175cm/gps/shape Cylinder

# Cylinder dimensions (match line_source geometry)
# Note: GPS doesn't support Rmin, so we confine to volume
/gate/source/F18_175cm/gps/radius 0.32 cm
/gate/source/F18_175cm/gps/halfz 87.5 cm

# Position: 4.5 mm off-center (matches line_source position)
/gate/source/F18_175cm/gps/centre 0.45 0.0 0.0 cm

# Isotropic angular distribution
/gate/source/F18_175cm/gps/angtype iso


# Ensures F-18 only spawns in active region (not polyethylene)
/gate/source/F18_175cm/gps/confine line_source

# List all sources
/gate/source/list



