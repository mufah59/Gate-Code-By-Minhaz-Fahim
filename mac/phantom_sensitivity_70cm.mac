##########################################################
# 70cm Line Source Phantom for Sensitivity Test
# Paper 7: Section 2.2.1 - Sensitivity
# NEMA NU-2 2018 Standard
# Configuration: No aluminum layers (baseline sensitivity)
##########################################################

/gate/world/daughters/name sensitivity_tube_70cm
/gate/world/daughters/insert cylinder

# Material: Polyethylene (phantom housing)
/gate/sensitivity_tube_70cm/setMaterial Polyethylene

# Geometry: Hollow tube
/gate/sensitivity_tube_70cm/geometry/setRmin 0.10 cm
/gate/sensitivity_tube_70cm/geometry/setRmax 0.16 cm
/gate/sensitivity_tube_70cm/geometry/setHeight 70.0 cm

# Position: Centered in scanner FOV
/gate/sensitivity_tube_70cm/placement/setTranslation 0 0 0 cm

# Visualization
/gate/sensitivity_tube_70cm/vis/setColor white
/gate/sensitivity_tube_70cm/vis/setVisible 1

# WATER + F-18 ACTIVITY (Inner Fillable Volume)

/gate/sensitivity_tube_70cm/daughters/name line_source_water
/gate/sensitivity_tube_70cm/daughters/insert cylinder

# Material: Water (carrier for F-18 radioisotope)
/gate/line_source_water/setMaterial Water

# Geometry: Solid cylinder (fills inner diameter)
# Radius: 0.10 cm (2.0 mm diameter)
# Length: 70.0 cm (same as tube)

/gate/line_source_water/geometry/setRmin 0.0 cm
/gate/line_source_water/geometry/setRmax 0.10 cm
/gate/line_source_water/geometry/setHeight 70.0 cm

# Position: Centered within polyethylene tube (0,0,0 relative to parent)
/gate/line_source_water/placement/setTranslation 0 0 0 cm

# Visualization
/gate/line_source_water/vis/setColor cyan
/gate/line_source_water/vis/setVisible 1



