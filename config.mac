##########################################################
# GATE Configuration - Major Experimental Parameters Only
##########################################################

##########################################################
# PHYSICS (Paper 7, Table 1)
##########################################################
/control/alias PHYSICS_LIST emlivermore_polar

# Production cuts (mm)
/control/alias CUT_PHANTOM 1.0
/control/alias CUT_LSO 1.0

##########################################################
# DIGITIZER (Paper 7, Table 1 & Figure 2)
##########################################################
# Energy resolution at 511 keV (Paper 7: 11.7%)
/control/alias ENERGY_RESOLUTION 0.117

# Energy window (keV)
/control/alias ENERGY_WINDOW_MIN 430.
/control/alias ENERGY_WINDOW_MAX 645.

##########################################################
# SOURCE ACTIVITY (Becquerels)
##########################################################
/control/alias SOURCE_ACTIVITY 100000.

# Count rate test activities (Paper 7, Section 2.2.2)
/control/alias SCATTER_70CM_ACTIVITY 100000.
/control/alias SCATTER_175CM_ACTIVITY 100000.

# NEMA IEC phantom activities (Paper 7, Section 2.5)
# Background: 5.1 kBq/cc, Sphere-to-Background Ratio: 3.7:1
/control/alias IEC_BACKGROUND_ACTIVITY 50000.
/control/alias IEC_SPHERE_ACTIVITY 185000.

##########################################################
# ACQUISITION TIMING (seconds)
##########################################################
/control/alias ACQ_TIME_START 0
/control/alias ACQ_TIME_SLICE 1
/control/alias ACQ_TIME_STOP 1

##########################################################
# NOTES:
# - Change SOURCE_ACTIVITY to adjust activity
# - Change ACQ_TIME_STOP to run longer/shorter
# - Change ENERGY_RESOLUTION to test detector performance
# - Physics and cuts match Paper 7 validation
# - For visualization: override timing/activity in main_visu.mac
##########################################################
